exports[`GalleryBodyView > lays out three tiles 1`] = `
<div>
  <div
    aria-label="Gallery with 3 items"
    class="GalleryBodyView-module_grid"
    data-layout="3"
    role="group"
  >
    <button
      aria-label="Image 1 of 3"
      class="GalleryBodyView-module_tile"
      type="button"
    >
      <img
        alt=""
        class="GalleryBodyView-module_thumbnail"
        loading="lazy"
        src="/static/wideImage.png"
      />
    </button>
    <button
      aria-label="Image 2 of 3"
      class="GalleryBodyView-module_tile"
      type="button"
    >
      <img
        alt=""
        class="GalleryBodyView-module_thumbnail"
        loading="lazy"
        src="/static/tallImage.png"
      />
    </button>
    <button
      aria-label="Image 3 of 3"
      class="GalleryBodyView-module_tile"
      type="button"
    >
      <img
        alt=""
        class="GalleryBodyView-module_thumbnail"
        loading="lazy"
        src="/static/element.png"
      />
    </button>
  </div>
</div>
`;

exports[`GalleryBodyView > marks videos with their duration 1`] = `
<div>
  <div
    aria-label="Gallery with 2 items"
    class="GalleryBodyView-module_grid"
    data-layout="2"
    role="group"
  >
    <button
      aria-label="Image 1 of 2"
      class="GalleryBodyView-module_tile"
      type="button"
    >
      <img
        alt=""
        class="GalleryBodyView-module_thumbnail"
        loading="lazy"
        src="/static/wideImage.png"
      />
    </button>
    <button
      aria-label="Video 2 of 2"
      class="GalleryBodyView-module_tile"
      type="button"
    >
      <img
        alt=""
        class="GalleryBodyView-module_thumbnail"
        loading="lazy"
        src="/static/wideImage.png"
      />
      <span
        class="GalleryBodyView-module_video"
      >
        <svg
          fill="currentColor"
          height="16"
          viewBox="0 0 24 24"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m8.98 4.677 9.921 5.58c1.36.764 1.36 2.722 0 3.486l-9.92 5.58C7.647 20.073 6 19.11 6 17.58V6.42c0-1.53 1.647-2.493 2.98-1.743"
