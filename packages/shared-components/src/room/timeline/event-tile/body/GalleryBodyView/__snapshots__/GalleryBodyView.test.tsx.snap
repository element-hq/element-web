        >
          0:42
        </span>
      </span>
    </button>
  </div>
</div>
`;

exports[`GalleryBodyView > renders loading and failed tiles without a thumbnail 1`] = `
<div>
  <div
    aria-label="Gallery with 3 items"
    class="GalleryBodyView-module_grid"
    data-layout="3"
    role="group"
  >
    <button
      aria-label="Image 1 of 3"
      class="GalleryBodyView-module_tile"
      type="button"
    >
      <img
        alt=""
        class="GalleryBodyView-module_thumbnail"
        loading="lazy"
        src="/static/wideImage.png"
      />
    </button>
    <button
      aria-label="Image 2 of 3"
      class="GalleryBodyView-module_tile"
      type="button"
    >
      <div
        class="GalleryBodyView-module_blurhash"
        style="display: inline-block; height: 100%; width: 100%; position: relative;"
      >
        <canvas
          height="32"
          style="position: absolute; inset: 0px; width: 100%; height: 100%;"
          width="32"
        />
      </div>
    </button>
    <button
      aria-label="Image 3 of 3, unable to show image due to error"
      class="GalleryBodyView-module_tile"
      type="button"
    >
      <svg
        class="GalleryBodyView-module_errorIcon"
        fill="currentColor"
        height="24"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M5 3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7.803a6 6 0 0 1-.72-2H5v-3.172l4-4 3.585 3.585a6 6 0 0 1 1.172-1.656l-3.343-3.343a2 2 0 0 0-2.828 0L5 13V5h14v7.083c.718.12 1.393.368 2 .72V5a2 2 0 0 0-2-2z"
        />
        <path
          d="M17 9a2 2 0 1 1-4 0 2 2 0 0 1 4 0m1 5a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1m-1 7a1 1 0 1 1 2 0 1 1 0 0 1-2 0"
        />
      </svg>
    </button>
  </div>
</div>
`;

