                  >
                    <div
                      class="RoomListItemView-module_ellipsis"
                    >
                      <div
                        class="RoomListItemView-module_roomName"
                        data-testid="room-name"
                        title="Off-topic"
                      >
                        Off-topic
                      </div>
                    </div>
                    <div
                      aria-hidden="true"
                      class="RoomListItemView-module_notificationDecoration"
                    />
                  </div>
                </div>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
