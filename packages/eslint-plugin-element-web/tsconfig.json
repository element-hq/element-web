{
    "$schema": "http://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "esnext",
        "lib": ["dom", "es2022", "esnext"],
        "strict": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": [],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true
    },
    "include": ["src"]
}
