{
    "name": "@element-hq/element-web-shared-utils",
    "type": "module",
    "version": "0.1.0",
    "description": "Shared utilities for Element Web",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/element-hq/element-web.git",
        "directory": "packages/shared-utils"
    },
    "author": "element-hq",
    "license": "SEE LICENSE IN README.md",
    "engines": {
        "node": ">=20.0.0"
    },
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/element-web-shared-utils.js",
            "require": "./lib/element-web-shared-utils.umd.cjs"
        },
        "./html": {
            "types": "./lib/index.d.ts",
            "import": "./lib/element-web-shared-utils.js",
            "require": "./lib/element-web-shared-utils.umd.cjs"
        }
    },
    "files": [
        "lib",
        "README.md"
    ],
    "scripts": {
        "prepack": "nx build",
        "lint:types": "nx lint:types",
        "test:unit": "vitest",
        "coverage": "pnpm test:unit --coverage",
        "coverage:diff": "diff-cover --config-file ../../diff-cover.toml coverage/lcov.info"
    },
    "devDependencies": {
        "@types/sanitize-html": "2.16.1",
        "@types/node": "catalog:ts6",
        "@typescript/native": "catalog:",
        "typescript": "catalog:ts6",
        "unplugin-dts": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "sanitize-html": "2.17.7"
    }
}
