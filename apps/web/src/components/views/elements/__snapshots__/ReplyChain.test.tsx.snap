// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ReplyChain > should call setQuoteExpanded if chain is longer than 2 lines 1`] = `
<DocumentFragment>
  <div
    class="mx_ReplyChain_wrapper"
  >
    <div />
    <div>
      <blockquote
        class="mx_ReplyChain mx_ReplyChain_color2"
      >
        <div
          class="_root"
          data-testid="reply-tile"
        >
          <a
            class="_link"
            href="#"
          >
            <div
              class="_sender"
              data-testid="reply-tile-sender"
            >
              <span
                aria-label="@userId:matrix.org"
                class="_avatar _avatar _avatar-imageless"
                data-color="2"
                data-type="round"
                role="img"
                style="--cpd-avatar-size: 16px;"
              >
                u
              </span>
              <div
                class="_senderProfile _disambiguatedProfile"
                data-event-density="default"
                data-event-layout="group"
                role="button"
                tabindex="0"
              >
                <span
                  class="mx_Username_color2 _disambiguatedProfile_displayName mx_DisambiguatedProfile_displayName"
                  dir="auto"
                >
                  @userId:matrix.org
                </span>
              </div>
            </div>
            <div
              class="_body"
              data-testid="reply-tile-body"
            >
              <div
                class="mx_MTextBody mx_EventTile_content _root _text"
                data-event-density="default"
                data-event-layout="group"
              >
                <div
                  class="mx_EventTile_body translate"
                  dir="auto"
                >
                  A
B
C
                </div>
              </div>
            </div>
          </a>
        </div>
      </blockquote>
    </div>
  </div>
</DocumentFragment>
`;
