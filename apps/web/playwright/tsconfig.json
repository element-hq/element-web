{
    "compilerOptions": {
        "target": "es2022",
        "jsx": "react",
        "lib": ["es2024", "dom", "dom.iterable"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "module": "ESNext",
        "allowImportingTsExtensions": true,
        "strict": true,
        "noUnusedLocals": true,
        "types": ["node"],
        "noEmit": true
    },
    "include": [
        "**/*.ts",
        "../src/@types/matrix-js-sdk.d.ts",

        // Some useful type declarations from the js-sdk
        "../node_modules/matrix-js-sdk/src/@types/another-json.d.ts",
        "../node_modules/matrix-js-sdk/src/@types/global.d.ts",
    ]
}
