.mx_NonUrgentEchoFailureToast {
    /* Center the icon on the text, and keep wrapped lines of text beside the icon */
    display: flex;
    align-items: center;

    svg {
        flex-shrink: 0;
        width: $font-18px;
        height: $font-18px;
        color: #fff; /* we know that non-urgent toasts are always styled the same */
        margin-right: 8px;
    }
}
