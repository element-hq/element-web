.mx_MStickerBody_wrapper {
    /* Spark renders stickers in a compact 114px-wide media box, with no
       additional Element wrapper padding.  The image keeps its source aspect
       ratio; very wide assets still retain Spark's 36px minimum height. */
    width: fit-content;
    max-width: min(100%, 45vw);
    padding: 0;

    .mx_MImageBody_thumbnail_container {
        width: min(100%, 114px) !important;
        max-width: 114px !important;
        max-height: none !important;
        min-height: 36px;
    }
}

.mx_MStickerBody_hidden {
    max-width: 220px;
    text-decoration: none;
    text-align: center;

    /* To center the text in the middle of the frame */
    display: flex;
    align-items: center;
    justify-content: center;
}

.mx_MStickerBody_placeholder {
    /* centering */
    position: absolute;
    left: calc(50% - 40px);
    top: calc(50% - 40px);
}
