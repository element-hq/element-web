.mx_ImageOcrPanel {
    position: absolute;
    right: 16px;
    bottom: 16px;
    max-width: min(480px, 45vw);
    max-height: 35vh;
    padding: 12px;
    overflow: auto;
    white-space: pre-wrap;
    color: #fff;
    background: rgb(0 0 0 / 80%);
    border-radius: 8px;
}

.mx_MAudioBody_transcriptionPanel {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 6px 0 0;
}

.mx_MAudioBody_transcriptionButton {
    width: fit-content;
    min-height: 22px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: $primary-content;
    font: var(--cpd-font-body-sm-medium);

    &:hover,
    &:focus-visible {
        color: $accent;
        text-decoration: underline;
    }

    &[data-loading="true"] {
        cursor: progress;
        opacity: 0.72;
    }
}

.mx_MAudioBody_transcriptionGlyph {
    display: inline-block;
    min-width: 20px;
    color: $primary-content;
    font-size: 15px;
    font-weight: var(--cpd-font-weight-semibold);
    line-height: 1;
}

.mx_MAudioBody_transcription {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-1x);
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, $input-border-color 68%, transparent);
    background: rgb(255 255 255 / 36%);
    color: $primary-content;
    white-space: pre-wrap;
    word-break: break-word;
    font: var(--cpd-font-body-sm-regular);
}

.mx_MAudioBody_transcriptionHint {
    color: $secondary-content;
}

.mx_MAudioBody_transcriptionError {
    color: $alert;
}
