.mx_ImageOcrPanel {
    position: absolute;
    right: 16px;
    bottom: 16px;
    max-width: min(480px, 45vw);
    max-height: 35vh;
    padding: 12px;
    overflow: auto;
    white-space: pre-wrap;
    color: #fff;
    background: rgb(0 0 0 / 80%);
    border-radius: 8px;
}

.mx_MAudioBody_transcription {
    display: block;
    margin-top: 8px;
    white-space: pre-wrap;
}

.mx_MAudioBody_transcriptionButton {
    margin-top: var(--cpd-space-1x);
    padding: 2px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--cpd-color-text-interactive-primary);
    font: var(--cpd-font-body-sm-medium);
}
