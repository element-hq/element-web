/** Disambiguated profile needs to have a different layout in the member tile */
.mx_MemberTileView .mx_DisambiguatedProfile {
    /* Name and the user status emoji share the first row (with the name truncating and the emoji always visible)
       Disambiguated MXID gets a full row below. */
    display: grid;
    /* The name column may shrink down to zero (truncating with an ellipsis) but never grows beyond its content.
       The emoji column is flexible, so it is never narrower than the emoji itself, and it is ignored by the
       intrinsic sizing of the spanning MXID row (which would otherwise squash the name column). */
    grid-template-columns: minmax(0, max-content) 1fr;

    .mx_DisambiguatedProfile_userStatus {
        margin-inline-start: var(--cpd-space-1-5x);
        /* Keep the emoji (and its tooltip trigger area) right after the name instead of stretching it */
        justify-self: start;
    }

    .mx_DisambiguatedProfile_mxid {
        grid-column: 1 / -1;
        margin-inline-start: 0;
        font: var(--cpd-font-body-sm-regular);
        text-overflow: ellipsis;
        overflow: hidden;
    }

    /* The user status emoji is excluded so that it is never clipped. */
    span:not(.mx_DisambiguatedProfile_mxid, .mx_DisambiguatedProfile_userStatus) {
        /**
        In a member tile, this span element is a grid child and so
        we need the following for text overflow to work.
        **/
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
}
