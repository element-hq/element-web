$button-size: 32px;
$button-gap: var(--cpd-space-3x);

:root {
    --image-view-panel-height: 68px;
}

.mx_ImageView {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;

    /* The preview window itself moves when its header is dragged. */
    will-change: transform;
}

.mx_ImageView_image_wrapper {
    pointer-events: initial;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    overflow: hidden;
}

.mx_ImageView_image {
    flex-shrink: 0;

    &.mx_ImageView_image_animating {
        transition: transform 200ms ease 0s;
    }

    &.mx_ImageView_image_animatingLoading {
        transition: transform 300ms ease 0s;
    }
}

.mx_ImageView_panel {
    width: 100%;
    height: var(--image-view-panel-height);
    display: flex;
    justify-content: space-between;
    align-items: center;
    animation-name: mx_ImageView_panel_keyframes;
    animation-duration: 300ms;

    cursor: grab;
    user-select: none;

    &[data-dragging] {
        cursor: grabbing;
    }
}

.mx_ImageView_info_wrapper {
    pointer-events: initial;
    padding-left: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    color: $lightbox-fg-color;
    flex-grow: 1;
    flex-basis: 0;
}

.mx_ImageView_info {
    padding-left: 12px;
    display: flex;
    flex-direction: column;
}

.mx_ImageView_info_sender {
    font-weight: bold;
}

.mx_ImageView_title {
    color: $lightbox-fg-color;
    font-size: $font-12px;
    flex-grow: 1;
    flex-basis: 0;
    text-align: center;
}

.mx_ImageView_toolbar {
    --icon-size: 24px;

    padding-right: 16px;
    pointer-events: initial;
    display: flex;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    justify-content: flex-end;
    gap: $button-gap;
}

.mx_ImageView_button {
    padding: calc(($button-size - var(--icon-size)) / 2);
    width: var(--icon-size);
    height: var(--icon-size);
    display: block;

    svg {
        height: inherit;
        width: inherit;
        display: block;
        color: $icon-button-color;
    }
}

.mx_ImageView_button_more {
    --icon-size: 28px;
}

.mx_ImageView_button_close {
    border-radius: 100%;
    background: #21262c; /* same on all themes */
}

/*
 * Spark/Cinny uses a floating image window on desktop.  Do not use the
 * full-screen lightbox rules here: the Matrix media URL, E2EE decryption and
 * ImageView controls remain Element's own implementation.
 */
.mx_Dialog_imageViewerWindow {
    padding: 28px;

    .mx_Dialog_border {
        width: min(88vw, 1240px);
        height: min(86vh, 860px);
        min-width: min(88vw, 1240px);
        min-height: min(86vh, 860px);
        max-width: calc(100vw - 40px);
        max-height: calc(100vh - 40px);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.74);
        border-radius: var(--cpd-radius-12, 12px);
        background: rgba(248, 250, 252, 0.78);
        box-shadow: 0 28px 80px rgba(15, 23, 42, 0.22);
        backdrop-filter: blur(22px) saturate(150%);
    }

    .mx_Dialog {
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        padding: 0;
        overflow: hidden;
        background: transparent;
    }

    .mx_Dialog_background {
        background: rgba(248, 250, 252, 0.36);
        opacity: 1;
    }

    &.mx_Dialog_imageViewerWindow_portrait .mx_Dialog_border {
        width: min(86vw, 1040px);
        height: min(92vh, 920px);
        min-width: min(86vw, 1040px);
        min-height: min(92vh, 920px);
    }

    &.mx_Dialog_imageViewerWindow_square .mx_Dialog_border {
        width: min(82vw, 980px);
        height: min(86vh, 860px);
        min-width: min(82vw, 980px);
        min-height: min(86vh, 860px);
    }
}

@media (max-width: 750px) {
    .mx_Dialog_imageViewerWindow {
        padding: 0;

        .mx_Dialog_border,
        &.mx_Dialog_imageViewerWindow_portrait .mx_Dialog_border,
        &.mx_Dialog_imageViewerWindow_square .mx_Dialog_border {
            width: 100vw;
            height: 100vh;
            min-width: 100vw;
            min-height: 100vh;
            max-width: 100vw;
            max-height: 100vh;
            border: 0;
            border-radius: 0;
        }
    }
}

@media (prefers-reduced-motion) {
    .mx_ImageView_image_animating {
        transition: none !important;
    }

    .mx_ImageView_image_animatingLoading {
        transition: none !important;
    }
}
