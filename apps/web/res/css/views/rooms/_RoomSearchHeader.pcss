/* Telegram-style in-room search bar that replaces the room header while searching. */
.mx_RoomSearchHeader {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
    gap: var(--cpd-space-1x);
    padding: var(--cpd-space-3x) var(--cpd-space-4x);
    background-color: var(--cpd-color-bg-canvas-default);
    border-bottom: 1px solid var(--cpd-color-bg-subtle-primary);

    .mx_RoomSearchHeader_form {
        width: 100%;
    }

    /* Let the input shrink inside the flex row rather than push the filter controls off-screen. */
    .mx_RoomSearchHeader_input {
        min-width: 0;
    }

    .mx_RoomSearchHeader_summary {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        min-height: 32px;
        overflow: hidden;

        > svg {
            flex-shrink: 0;
            padding: var(--cpd-space-1x);
            border-radius: var(--cpd-space-1x);
            background-color: var(--cpd-color-bg-subtle-secondary);
            color: var(--cpd-color-icon-secondary);
        }

        .mx_RoomSearchHeader_summary_text {
            flex-grow: 1;
            display: flex;
            align-items: center;
            gap: var(--cpd-space-2x);
            overflow: hidden;
            font-size: $font-15px;
            line-height: $font-22px;

            span {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .mx_SearchWarning {
                display: contents;
                font-size: $font-13px;
                line-height: $font-20px;
                color: var(--cpd-color-text-secondary);
            }
        }

        .mx_RoomSearchHeader_summary_actions {
            display: flex;
            align-items: center;
            gap: var(--cpd-space-4x);
            flex-shrink: 0;
        }
    }
}
