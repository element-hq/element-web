.mx_Stickers_content {
    overflow: hidden;
}

.mx_Stickers_content_container {
    overflow: hidden;
    height: 300px;
}

#mx_persistedElement_stickerPicker {
    .mx_AppTileFullWidth {
        height: unset;
        box-sizing: border-box;
        border-left: none;
        border-right: none;
        border-bottom: none;
    }

    .mx_AppTileMenuBar {
        padding: 0;
    }

    iframe {
        /* Sticker picker depends on the fixed height previously used for all tiles */
        height: 283px; /* height of the popout minus the AppTile menu bar */
    }
}

.mx_Stickers_contentPlaceholder {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.mx_Stickers_contentPlaceholder p {
    max-width: 200px;
}

.mx_Stickers_addLink {
    display: inline;
    cursor: pointer;
    color: $accent;
}

.mx_RemoteStickerTab_tabs {
    display: flex;
    gap: var(--cpd-space-1x);
    padding: var(--cpd-space-2x);
    border-bottom: 1px solid $system;
}

.mx_RemoteStickerTab_tab {
    min-height: 30px;
    padding: 0 var(--cpd-space-2x);
    border-radius: 6px;
}

.mx_RemoteStickerTab_tab_active {
    color: $accent-fg-color;
    background: $accent;
}

.mx_RemoteStickerTab_emojiPanel {
    width: min(432px, calc(100vw - 24px));
    overflow: hidden;
    border-radius: 8px;
    background: $background;
}

.mx_RemoteStickerTab {
    height: 390px;
    padding: var(--cpd-space-2x);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
}

.mx_RemoteStickerTab_toolbar {
    display: flex;
    gap: var(--cpd-space-2x);
}

.mx_RemoteStickerTab_search {
    min-width: 0;
    height: 36px;
    box-sizing: border-box;
    border: 1px solid $input-border-color;
    border-radius: 6px;
    background: $background;
    color: $primary-content;
    font: var(--cpd-font-body-md-regular);
    flex: 1;
    padding: 0 var(--cpd-space-2x);
}

.mx_RemoteStickerTab_content {
    display: flex;
    flex: 1;
    min-height: 0;
    gap: var(--cpd-space-2x);
}

.mx_RemoteStickerTab_grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cpd-space-1x);
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    align-content: start;
}

.mx_RemoteStickerTab_packRail {
    width: 42px;
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-1x);
    overflow-y: auto;
    scrollbar-width: none;
}

.mx_RemoteStickerTab_packButton {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: $secondary-content;
    font: var(--cpd-font-body-xs-medium);

    &[data-active="true"] {
        border-color: $accent;
        background: $spacePanel-bg-color;
    }

    img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
}

.mx_RemoteStickerTab_item {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 6px;
    background: transparent;

    &:hover {
        background: $spacePanel-bg-color;
    }
}

.mx_RemoteStickerTab_item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.mx_RemoteStickerTab_empty {
    width: min(432px, calc(100vw - 24px));
    height: 390px;
    padding: 24px;
    text-align: center;
    box-sizing: border-box;
}
