.mx_Stickers_content {
    overflow: hidden;
}

.mx_Stickers_content_container {
    overflow: hidden;
    height: 300px;
}

#mx_persistedElement_stickerPicker {
    .mx_AppTileFullWidth {
        height: unset;
        box-sizing: border-box;
        border-left: none;
        border-right: none;
        border-bottom: none;
    }

    .mx_AppTileMenuBar {
        padding: 0;
    }

    iframe {
        /* Sticker picker depends on the fixed height previously used for all tiles */
        height: 283px; /* height of the popout minus the AppTile menu bar */
    }
}

.mx_Stickers_contentPlaceholder {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.mx_Stickers_contentPlaceholder p {
    max-width: 200px;
}

.mx_Stickers_addLink {
    display: inline;
    cursor: pointer;
    color: $accent;
}

.mx_RemoteStickerTab_tabs {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    min-height: 50px;
    padding: 0 var(--cpd-space-3x);
    box-sizing: border-box;
    border-bottom: 1px solid $message-action-bar-border-color;
}

.mx_RemoteStickerTab_tab {
    min-height: 32px;
    padding: 0 var(--cpd-space-2x);
    border-radius: 7px;
    font: var(--cpd-font-body-md-semibold);
}

.mx_RemoteStickerTab_tab_active {
    color: $accent-fg-color;
    background: $accent;
}

.mx_RemoteStickerTab_emojiPanel {
    width: min(432px, calc(100vw - 24px));
    height: min(450px, calc(100dvh - 32px));
    overflow: hidden;
    border: 1px solid $message-action-bar-border-color;
    border-radius: 12px;
    background: $background;
    box-shadow: 0 12px 32px rgb(15 23 42 / 18%);
}

.mx_EmojiBoardShell {
    display: flex;
    flex-direction: column;
}

.mx_EmojiBoardShell_body {
    display: flex;
    min-height: 0;
    flex: 1;
}

.mx_EmojiBoardShell_body > .mx_EmojiPicker,
.mx_EmojiBoardShell_body > .mx_RemoteStickerTab {
    width: 100%;
    height: 100%;
}

.mx_RemoteStickerTab {
    height: 100%;
    padding: var(--cpd-space-3x);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
}

.mx_RemoteStickerTab_toolbar {
    display: flex;
    gap: var(--cpd-space-2x);
}

.mx_RemoteStickerTab_sendMode {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    overflow-x: auto;
    color: $secondary-content;
    font: var(--cpd-font-body-sm-medium);
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }
}

.mx_RemoteStickerTab_sendModeButton {
    flex: 0 0 auto;
    min-height: 24px;
    padding: 0 var(--cpd-space-2x);
    border: 1px solid transparent;
    border-radius: 7px;
    color: $secondary-content;
    font: var(--cpd-font-body-sm-medium);

    &[data-active="true"] {
        border-color: transparent;
        background: $primary-content;
        color: $background;
    }
}

.mx_RemoteStickerTab_search {
    min-width: 0;
    height: 42px;
    box-sizing: border-box;
    border: 3px solid color-mix(in srgb, $input-border-color 75%, $system);
    border-radius: 10px;
    background: $spacePanel-bg-color;
    color: $primary-content;
    font: var(--cpd-font-body-md-regular);
    flex: 1;
    padding: 0 var(--cpd-space-2x);
}

.mx_RemoteStickerTab_content {
    display: flex;
    flex: 1;
    min-height: 0;
    gap: var(--cpd-space-3x);
}

.mx_RemoteStickerTab_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 48px);
    justify-content: space-around;
    gap: var(--cpd-space-2x);
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    align-content: start;

    &[data-mode="sticker"] {
        grid-template-columns: repeat(auto-fill, 112px);
        justify-content: space-evenly;
    }
}

.mx_RemoteStickerTab_groupLabel {
    position: sticky;
    z-index: 1;
    top: 0;
    grid-column: 1 / -1;
    width: fit-content;
    margin: 0 auto var(--cpd-space-1x);
    padding: 2px var(--cpd-space-2x);
    border-radius: 999px;
    background: $spacePanel-bg-color;
    color: $primary-content;
    font: var(--cpd-font-body-sm-medium);
}

.mx_RemoteStickerTab_packRail {
    width: 54px;
    padding-inline-start: 8px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-1x);
    overflow-y: auto;
    scrollbar-width: none;
}

.mx_RemoteStickerTab_packButton {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: $secondary-content;
    font: var(--cpd-font-body-xs-medium);

    &[data-active="true"] {
        border-color: $accent;
        background: $spacePanel-bg-color;
    }

    img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
}

.mx_RemoteStickerTab_item {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 9px;
    background: transparent;

    &:hover {
        background: $spacePanel-bg-color;
    }
}

.mx_RemoteStickerTab_item img {
    width: 32px;
    height: 32px;
    object-fit: contain;
}

.mx_RemoteStickerTab_grid[data-mode="sticker"] .mx_RemoteStickerTab_item {
    width: 112px;
    height: 112px;
}

.mx_RemoteStickerTab_grid[data-mode="sticker"] .mx_RemoteStickerTab_item img {
    width: 96px;
    height: 96px;
}

.mx_RemoteStickerTab_preview {
    min-height: 74px;
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    padding: 0 var(--cpd-space-2x);
    border-radius: 10px;
    background: $spacePanel-bg-color;
    color: $primary-content;
    font: var(--cpd-font-body-md-medium);

    img {
        width: 60px;
        height: 60px;
        object-fit: contain;
    }
}

.mx_RemoteStickerTab_empty {
    width: min(432px, calc(100vw - 24px));
    height: min(450px, calc(100dvh - 32px));
    padding: 24px;
    text-align: center;
    box-sizing: border-box;
}
