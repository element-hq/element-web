/* The file search replaces the card title, so it takes all the header space left by the close button. */
.mx_RoomFilesView_search {
    flex: 1;
    min-width: 0;
}

.mx_RoomFilesView_filters {
    padding: var(--cpd-space-4x) var(--cpd-space-3x);
    box-sizing: border-box;
    width: 100%;

    /* The category chips scroll horizontally rather than wrap in the narrow right panel. */
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }
}
