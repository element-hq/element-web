.mx_RoomFilesView_header {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-2x) var(--cpd-space-4x) var(--cpd-space-3x);
    box-sizing: border-box;
    width: 100%;
    border-bottom: 1px solid var(--cpd-color-gray-400);

    .mx_RoomFilesView_tabs {
        /* The typed media tabs scroll horizontally rather than wrap in the narrow right panel. */
        overflow-x: auto;
        scrollbar-width: none;

        &::-webkit-scrollbar {
            display: none;
        }
    }

    .mx_RoomFilesView_search {
        width: 100%;
    }
}
