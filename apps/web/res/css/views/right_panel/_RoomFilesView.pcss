/* The search is the first body row under the card's nav header, inset 16px from each edge. It carries no bottom
   padding of its own — the filter row below supplies the 16px gap between the two. */
.mx_RoomFilesView_search {
    padding: var(--cpd-space-4x) var(--cpd-space-4x) 0;
    box-sizing: border-box;
    width: 100%;
}

.mx_RoomFilesView_filters {
    padding: var(--cpd-space-4x);
    box-sizing: border-box;
    width: 100%;

    /* The category chips scroll horizontally rather than wrap in the narrow right panel. */
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }
}
