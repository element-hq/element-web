.mx_PdfViewerCard iframe {
    width: 100%;
    height: 100%;
    border: none;
}

.mx_PdfViewerCard .mx_PdfViewerCard_Spinner {
    height: 100%;
}

.mx_PdfViewerCard_Error {
    svg {
        color: red;
        width: 50px;
        height: 50px;
    }

    align-content: center;
    text-align: center;
    height: 100%;
    margin: var(--cpd-space-2x);
}
