/* The list scrolls itself, so the dialog must never grow a scrollbar of its own: its square
   track would paint over the frame's rounded corners. */
.mx_Dialog:has(> .mx_ForwardDialog) {
    overflow-y: hidden;
}

/* The list styling lives in the shared ForwardDialogView; only the dialog frame and the
   EventTile preview (which is rendered by the web app) are styled here. */
.mx_ForwardDialog {
    /* A flex column so the shared view can shrink and scroll its list instead of
       overflowing the dialog. The height must stay below the viewport, otherwise
       .mx_Dialog scrolls as a whole and its content escapes the rounded corners. */
    display: flex;
    flex-direction: column;
    min-height: 0;
    /* Prefer a tall dialog, but never taller than the viewport (minus .mx_Dialog padding and
       the gap .mx_Dialog_border keeps from the edges), so .mx_Dialog itself never scrolls. */
    height: min(800px, 80vh);

    > .mx_Dialog_header {
        flex-shrink: 0;
    }

    > .mx_ForwardDialog_preview {
        div {
            pointer-events: none;
        }

        /* When forwarding messages from encrypted rooms, EventTile will complain */
        /* that our preview is unencrypted, which doesn't actually matter */
        /* We also hide download links to not encourage users to try interacting */
        /* The file tile's inline download and open actions go for the same reason */
        .mx_ReadReceiptGroup,
        .mx_E2ePadlock,
        .mx_MFileBody [data-type="download"],
        .mx_MFileBody [data-type="actions"] {
            display: none;
        }
    }
}
