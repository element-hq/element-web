.mx_ElementCallMock {
    flex-grow: 1;
    min-height: 0;
    overflow: auto;

    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);

    padding: var(--cpd-space-4x);
    color: var(--cpd-color-text-primary);
    background-color: var(--cpd-color-bg-subtle-secondary);

    h3 {
        margin: 0 0 var(--cpd-space-1x);
        font: var(--cpd-font-body-md-semibold);
    }

    .mx_ElementCallMock_roomId,
    .mx_ElementCallMock_empty {
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-sm-regular);
    }

    .mx_ElementCallMock_error {
        color: var(--cpd-color-text-critical-primary);
    }

    .mx_ElementCallMock_members {
        margin: 0;
        padding-inline-start: var(--cpd-space-5x);
    }

    .mx_ElementCallMock_buttons {
        display: flex;
        flex-wrap: wrap;
        gap: var(--cpd-space-2x);
        margin-bottom: var(--cpd-space-2x);
    }

    .mx_ElementCallMock_log,
    .mx_ElementCallMock_config {
        margin: var(--cpd-space-2x) 0 0;
        padding: var(--cpd-space-2x) var(--cpd-space-3x);
        max-height: 12em;
        overflow: auto;
        font: var(--cpd-font-body-xs-regular);
        font-family: var(--cpd-font-family-mono);
        background-color: var(--cpd-color-bg-canvas-default);
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: var(--cpd-space-2x);
    }

    .mx_ElementCallMock_log {
        padding-inline-start: var(--cpd-space-8x);
    }
}
