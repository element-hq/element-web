/*
 * `normalize` and `compound-legacy` belong to Element Call's stylesheet (loaded with the call component, see
 * `ElementCallComponent.css`): its element reset and legacy base styles, which must sit below Compound's
 * component styles, as they do in Element Call itself. `compound` is where Element Call keeps its copy of
 * Compound; it stays empty here, as Element Web's own copy is what the component uses.
 */
@layer normalize, compound-legacy, compound-tokens, compound-web, compound, shared-components, app-web;

@import url("maplibre-gl/dist/maplibre-gl.css") layer(app-web);
@import url("@vector-im/compound-design-tokens/assets/web/css/compound-design-tokens.css") layer(compound-tokens);
@import url("@vector-im/compound-web/dist/style.css") layer(compound-web);
/** Shared components is layer-aware and will fit itself into the correct layer */
@import url("@element-hq/web-shared-components/dist/element-web-shared-components.css");
