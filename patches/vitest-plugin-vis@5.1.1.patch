+// Recorded as vitest's own built-in `internal:toMatchScreenshot`/"visual-regression" artifact shape
+// (the same one `@vitest/browser`'s native `toMatchScreenshot()` uses), so the HTML/UI reporter
+// renders these with its existing image-diff viewer. Unlike `context.annotate`, `recordArtifact`
+// has no "must be called during the test's own run" restriction, so this works equally from the
+// `afterEach`-based "auto" snapshot matcher and from an explicit assertion in a story's `play()`.
+// Still best-effort: never let a recording failure mask the real comparison error below.
+async function recordVisualRegressionArtifact(task, message, attachments) {
+	if (!task) return;
+	try {
+		await recordArtifact(task, {
+			type: "internal:toMatchScreenshot",
+			kind: "visual-regression",
+			message,
+			attachments
+		});
+	} catch {}
+}
 
