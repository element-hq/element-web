{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "targets": {
        "build": {
            "cache": true,
            "command": "vite build",
            "inputs": [
                "production",
                "buildConfig",
                "{workspaceRoot}/modules/tsconfig.json",
                "{workspaceRoot}/packages/module-api/vite.base.ts",
                { "dependentTasksOutputFiles": "**/*" }
            ],
            "outputs": ["{projectRoot}/lib"],
            "options": { "cwd": "modules/banner" },
            "dependsOn": ["^build"]
        },
        "lint:types": {
            "command": "tsc --noEmit",
            "options": {
                "cwd": "modules/banner"
            },
            "dependsOn": ["^build"]
        }
    }
}
